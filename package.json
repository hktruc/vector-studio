{
  "name": "vector-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Bộ vẽ hình vector cho slide, sơ đồ và thiết kế — xuất SVG dùng được trong Canva.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
